# ==========================================
# VERDICT AI - Environment Configuration
# ==========================================

# Application
APP_NAME="VERDICT AI Backend"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=verdict-super-secure-secret-key-change-in-prod-2026
API_KEY_HEADER=X-VERDICT-API-KEY
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database (PostgreSQL with pgvector, or fallback to SQLite for local standalone development)
# DATABASE_URL=postgresql+asyncpg://verdict_user:verdict_pass@localhost:5432/verdict_db
DATABASE_URL=sqlite+aiosqlite:///./verdict.db
DATABASE_SYNC_URL=sqlite:///./verdict.db

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Fallback LLM / Embedding
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Uploads
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# Edge Gateway
EDGE_GATEWAY_PORT=8001
EDGE_GATEWAY_TOKEN=verdict-edge-token-2026
